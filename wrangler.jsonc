{
	"name": "iran-prosperity-rag",
	"compatibility_date": "2026-01-27",
	"main": "worker/index.js",
	"ai": { "binding": "AI" },
	"vectorize": [
	  { "binding": "VECTORIZE", "index_name": "ipp-docs", "remote": true }
	],
	"observability": {
	  "enabled": false,
	  "head_sampling_rate": 1,
	  "logs": {
		"enabled": true,
		"head_sampling_rate": 1,
		"persist": true,
		"invocation_logs": true
	  },
	  "traces": {
		"enabled": false,
		"persist": true,
		"head_sampling_rate": 1
	  }
	}
  }
  